---
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import { categoryBySlug } from '@data/catalogue';
import { categoryJsonLd } from '@lib/schema';
import { whatsappHref } from '@lib/whatsapp';

const category = categoryBySlug('pastries');
const canonicalUrl = 'https://perlettecakes.com/pastries/';
const jsonLd = categoryJsonLd(category, canonicalUrl);
const orderHref = whatsappHref(category.whatsappMessage);
const pastryImage = category.signature.image;
const pastryImageAlt = category.signature.imageAlt;
const pastrySlides = [
	{
		image: category.signature.image,
		imageAlt: category.signature.imageAlt,
		title: 'Pastry boxes for every table',
		description: category.signature.crave,
	},
	...category.variations.slice(0, 3).map((variation) => ({
		image: variation.image,
		imageAlt: variation.imageAlt,
		title: variation.name,
		description: variation.crave,
	})),
];
---

<Layout
	title={category.title}
	description={category.description}
	canonicalUrl={canonicalUrl}
	noIndex={false}
	jsonLd={jsonLd}
	socialImageAlt={pastryImageAlt}
>
	<main class="pastries-page">
		<section class="pastry-hero content-shell" aria-labelledby="pastry-hero-title">
			<div class="pastry-hero__media">
				<Image
					src={pastryImage}
					alt={pastryImageAlt}
					loading="eager"
					fetchpriority="high"
					widths={[720, 1080, 1600, 2000]}
					sizes="(min-width: 64rem) 73vw, 100vw"
					quality={78}
				/>
			</div>
			<div class="pastry-hero__copy">
				<p class="pastry-hero__eyebrow">Fresh from Perlette Cakes</p>
				<h1 id="pastry-hero-title">Pastries made for the good part of the day.</h1>
				<p>
					Buttery, golden pastries baked to order in Klang Valley, Malaysia. Pick a box for
					sharing, gifting, or keeping all to yourself.
				</p>
				<a
					class="button pastry-hero__button"
					href={orderHref}
					target="_blank"
					rel="noreferrer"
					data-order-trigger
					data-order-interest-preselect="Pastries"
				>
					Order on WhatsApp
				</a>
			</div>
		</section>

		<section class="pastry-bento" aria-labelledby="pastry-bento-title">
			<div class="pastry-bento__heading" data-reveal>
				<p class="section-kicker">Our pastries</p>
				<h2 id="pastry-bento-title">A little more than a pastry box.</h2>
			</div>

			<div class="pastry-bento__grid content-shell">
				<article class="pastry-bento__selection" data-pastry-gallery data-reveal>
					<div class="pastry-bento__selection-media">
						{pastrySlides.map((slide, index) => (
							<div class="pastry-bento__slide" data-pastry-slide hidden={index !== 0}>
								<Image
									src={slide.image}
									alt={slide.imageAlt}
									widths={[480, 720, 960]}
									sizes="(min-width: 64rem) 25vw, 50vw"
									quality={74}
								/>
							</div>
						))}
					</div>
					<div class="pastry-bento__selection-copy">
						<div class="pastry-bento__controls" aria-label="Choose a pastry view">
							{pastrySlides.map((slide, index) => (
								<button
									type="button"
									class="pastry-bento__control"
									data-pastry-gallery-button
									data-pastry-title={slide.title}
									data-pastry-description={slide.description}
									aria-label={`View ${slide.title}`}
									aria-pressed={index === 0}
								>
									{String(index + 1).padStart(2, '0')}
								</button>
							))}
						</div>
						<h3 data-pastry-gallery-title aria-live="polite">{pastrySlides[0].title}</h3>
						<p data-pastry-gallery-description aria-live="polite">{pastrySlides[0].description}</p>
					</div>
				</article>

				<div class="pastry-bento__feature" data-reveal>
					<Image
						src={pastryImage}
						alt="Fresh savoury quiche pastries with golden pastry crusts, spinach, mushrooms, and herbs."
						widths={[720, 1080, 1600]}
						sizes="(min-width: 64rem) 50vw, 100vw"
						quality={76}
					/>
				</div>

				<article class="pastry-bento__testimonial" data-reveal>
					<p class="pastry-bento__quote">"Gooey, freshly baked pastry is to die for."</p>
					<p class="pastry-bento__attribution">Small batches, baked to order and delivered across Klang Valley.</p>
				</article>

				<a
					class="pastry-bento__order"
					href={orderHref}
					target="_blank"
					rel="noreferrer"
					data-order-trigger
					data-order-interest-preselect="Pastries"
					data-reveal
				>
					<span class="pastry-bento__order-label">Ready for your next pastry box?</span>
					<span class="pastry-bento__order-link">Order on WhatsApp <span aria-hidden="true">&rarr;</span></span>
				</a>
			</div>
		</section>

		<section class="pastry-process" aria-labelledby="pastry-process-title">
			<div class="pastry-process__copy" data-reveal>
				<p class="section-kicker">The Perlette way</p>
				<h2 id="pastry-process-title">Fresh pastries, made differently.</h2>
				<ul class="pastry-process__list">
					<li>Baked to order, so every box leaves the oven at its best.</li>
					<li>Small-batch fillings and pastry, made with care in a home kitchen.</li>
					<li>Boxed fresh for gifting, gatherings, and everyday treats.</li>
				</ul>
				<p class="pastry-process__lead-time">
					Pastry orders are best placed 3 to 5 days ahead. Tell us your date and box on
					WhatsApp, and we will arrange the bake and delivery.
				</p>
			</div>

			<div class="pastry-process__main-image" data-reveal>
				<Image
					src={pastryImage}
					alt="A freshly baked spinach and mushroom quiche with a crisp golden crust."
					widths={[720, 1080, 1600]}
					sizes="(min-width: 64rem) 38vw, 100vw"
					quality={76}
				/>
			</div>

			<div class="pastry-process__detail-images" aria-label="Pastry details">
				<div class="pastry-process__detail pastry-process__detail--top" data-reveal>
					<Image src={pastryImage} alt="Close detail of the golden quiche pastry crust." widths={[480, 720]} sizes="(min-width: 64rem) 15vw, 50vw" quality={74} />
				</div>
				<div class="pastry-process__detail pastry-process__detail--bottom" data-reveal>
					<Image src={pastryImage} alt="Freshly baked quiche pastries arranged in a box." widths={[480, 720]} sizes="(min-width: 64rem) 15vw, 50vw" quality={74} />
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	const pastryGallery = document.querySelector<HTMLElement>('[data-pastry-gallery]');

	if (pastryGallery) {
		const slides = Array.from(pastryGallery.querySelectorAll<HTMLElement>('[data-pastry-slide]'));
		const buttons = Array.from(pastryGallery.querySelectorAll<HTMLButtonElement>('[data-pastry-gallery-button]'));
		const title = pastryGallery.querySelector<HTMLElement>('[data-pastry-gallery-title]');
		const description = pastryGallery.querySelector<HTMLElement>('[data-pastry-gallery-description]');

		buttons.forEach((button, index) => {
			button.addEventListener('click', () => {
				slides.forEach((slide, slideIndex) => {
					slide.hidden = slideIndex !== index;
				});
				buttons.forEach((control, controlIndex) => {
					control.setAttribute('aria-pressed', String(controlIndex === index));
				});
				if (title) title.textContent = button.dataset.pastryTitle ?? '';
				if (description) description.textContent = button.dataset.pastryDescription ?? '';
			});
		});
	}
</script>

<style>
	.pastries-page {
		background: var(--white-bg);
	}

	.pastry-hero {
		display: grid;
		gap: var(--space-xl);
		align-items: center;
		padding-top: var(--space-2xl);
		padding-bottom: var(--space-2xl);
		background: var(--color-surface-soft);
	}

	.pastry-hero__media {
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-surface-soft);
	}

	.pastry-hero__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 48%;
	}

	.pastry-hero__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: var(--space-lg);
		max-width: 38rem;
		padding: var(--space-xl);
		background: var(--pink-primary-bg);
		color: var(--white-text);
	}

	.pastry-hero__copy h1 {
		max-width: 11ch;
		font-size: clamp(2.8rem, 5vw, 5rem);
		line-height: 0.93;
		text-wrap: balance;
	}

	.pastry-hero__copy > p:not(.pastry-hero__eyebrow) {
		max-width: 28rem;
		color: var(--white-text);
	}

	.pastry-hero__eyebrow,
	.section-kicker {
		font-size: var(--label-text-font-size);
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.2;
		text-transform: uppercase;
		color: var(--color-primary-strong);
	}

	.pastry-hero__eyebrow {
		color: var(--white-text);
	}

	.pastry-hero__button {
		color: var(--white-text);
		border-color: var(--white-text);
		background: transparent;
		box-shadow: none;
	}

	.pastry-hero__button:hover {
		color: var(--color-primary-strong);
		background: var(--white-text);
	}

	.pastry-bento {
		padding-block: var(--top-space-section-md) var(--bottom-space-section-md);
	}

	.pastry-bento__heading {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-md);
		padding-inline: var(--side-space-section-sm);
		text-align: center;
	}

	.pastry-bento__heading h2 {
		max-width: 18ch;
		color: var(--color-primary-strong);
		font-size: clamp(2.6rem, 5vw, 5rem);
		text-wrap: balance;
	}

	.pastry-bento__grid {
		display: grid;
		grid-template-areas:
			"feature feature"
			"selection selection"
			"testimonial order";
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-xs);
		margin-top: var(--space-2xl);
	}

	.pastry-bento__testimonial,
	.pastry-bento__order,
	.pastry-bento__feature,
	.pastry-bento__selection {
		min-width: 0;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.pastry-bento__selection {
		grid-area: selection;
		display: flex;
		min-height: 15rem;
		background: var(--color-surface);
		border: 1px solid var(--color-primary-strong);
	}

	.pastry-bento__selection-media {
		flex: 0 0 50%;
		min-width: 0;
		aspect-ratio: 1;
		background: var(--color-surface-soft);
	}

	.pastry-bento__slide {
		height: 100%;
	}

	.pastry-bento__slide[hidden] {
		display: none;
	}

	.pastry-bento__selection-media :global(img),
	.pastry-bento__feature :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pastry-bento__selection-copy {
		display: flex;
		min-width: 0;
		flex: 1 1 auto;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-start;
		gap: var(--space-md);
		padding: var(--space-lg);
	}

	.pastry-bento__controls {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
	}

	.pastry-bento__control {
		display: inline-flex;
		min-width: 2.75rem;
		min-height: 2.75rem;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 1px solid var(--color-primary-strong);
		border-radius: var(--radius-md);
		background: transparent;
		color: var(--color-primary-strong);
		font-size: var(--step--1);
		font-weight: 700;
		transition: background-color var(--transition-base), color var(--transition-base), transform var(--transition-base);
	}

	.pastry-bento__control:hover,
	.pastry-bento__control[aria-pressed="true"] {
		background: var(--color-primary-strong);
		color: var(--white-text);
	}

	.pastry-bento__control:hover {
		transform: translateY(-1px);
	}

	.pastry-bento__selection-copy h3 {
		font-size: var(--step-1);
		line-height: 1.05;
	}

	.pastry-bento__selection-copy p {
		font-size: var(--label-text-font-size);
		color: var(--color-text-muted);
	}

	.pastry-bento__testimonial {
		grid-area: testimonial;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: var(--space-xl);
		background: var(--color-surface-soft);
		border: 1px solid var(--color-nav-border);
	}

	.pastry-bento__quote {
		max-width: 22ch;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.5vw, 2.25rem);
		line-height: 1;
		letter-spacing: -0.04em;
		color: var(--color-primary-strong);
	}

	.pastry-bento__attribution {
		margin-top: var(--space-md);
		font-size: var(--label-text-font-size);
		color: var(--color-text-muted);
	}

	.pastry-bento__feature {
		grid-area: feature;
		aspect-ratio: 4 / 3;
		background: var(--color-surface-soft);
	}

	.pastry-bento__order {
		grid-area: order;
		position: relative;
		display: flex;
		min-height: 12rem;
		padding: var(--space-xl);
		flex-direction: column;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-md);
		background: var(--pink-primary-bg);
		color: var(--white-text);
		text-decoration: none;
		cursor: pointer;
		box-shadow: var(--shadow-sm);
		transition: transform var(--transition-base), box-shadow var(--transition-base);
	}

	.pastry-bento__order:hover,
	.pastry-bento__order:focus-visible {
		transform: translateY(-0.25rem);
		box-shadow: var(--shadow-md), var(--focus-ring);
	}

	.pastry-bento__order-label,
	.pastry-bento__order-link {
		max-width: 12ch;
		font-family: var(--font-display);
		font-size: var(--step-1);
		line-height: 1.05;
	}

	.pastry-bento__order-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		max-width: none;
		font-family: var(--font-body);
		font-size: var(--label-text-font-size);
		font-weight: 700;
	}

	.pastry-bento__order-link span {
		display: inline-block;
		transition: transform var(--transition-base);
	}

	.pastry-bento__order:hover .pastry-bento__order-link span {
		transform: translateX(0.25rem);
	}

	@keyframes pastry-order-arrow {
		0%,
		65%,
		100% {
			transform: translateX(0);
		}
		75%,
		85% {
			transform: translateX(0.3rem);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.pastry-bento__order-link span {
			animation: pastry-order-arrow 3.2s ease-in-out infinite;
		}
	}

	@media (max-width: 35rem) {
		.pastry-bento__grid {
			grid-template-areas:
				"feature"
				"selection"
				"testimonial"
				"order";
			grid-template-columns: minmax(0, 1fr);
		}

		.pastry-bento__selection {
			flex-direction: column;
		}

		.pastry-bento__selection-media {
			flex-basis: auto;
			aspect-ratio: 4 / 3;
		}
	}

	.pastry-process {
		display: grid;
		gap: var(--space-md);
		padding: var(--top-space-section-md) var(--side-space-section-sm) var(--bottom-space-section-md);
		background: var(--color-surface-soft);
	}

	.pastry-process__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-lg);
	}

	.pastry-process__copy h2 {
		max-width: 10ch;
		font-size: clamp(2.8rem, 5vw, 5rem);
		line-height: 0.92;
		text-wrap: balance;
		color: var(--color-text);
	}

	.pastry-process__list {
		display: grid;
		gap: var(--space-sm);
		padding: 0;
		list-style: none;
		color: var(--color-primary-strong);
	}

	.pastry-process__list li {
		position: relative;
		padding-left: 1.5rem;
	}

	.pastry-process__list li::before {
		content: "✓";
		position: absolute;
		left: 0;
		font-weight: 700;
		color: var(--pink-primary-bg);
	}

	.pastry-process__lead-time {
		max-width: 34rem;
		color: var(--color-text-muted);
	}

	.pastry-process__main-image,
	.pastry-process__detail {
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.pastry-process__main-image {
		min-height: clamp(18rem, 30vw, 28rem);
	}

	.pastry-process__main-image :global(img),
	.pastry-process__detail :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pastry-process__detail-images {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-md);
	}

	.pastry-process__detail {
		aspect-ratio: 1 / 1;
	}

	.pastry-process__detail--top :global(img) {
		object-position: 22% center;
	}

	.pastry-process__detail--bottom :global(img) {
		object-position: 78% center;
	}

	@media (min-width: 48rem) {
		.pastry-hero {
			grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
			gap: var(--space-2xl);
		}

		.pastry-hero__copy {
			padding-inline: var(--space-xl);
		}

		.pastry-process {
			grid-template-columns: 1fr 1.15fr;
			padding-inline: var(--side-space-section-md);
		}

		.pastry-process__copy {
			grid-row: span 2;
			justify-content: center;
			padding-right: var(--space-xl);
		}

		.pastry-process__main-image {
			min-height: clamp(20rem, 32vw, 28rem);
		}

		.pastry-process__detail-images {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.pastry-hero {
			grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr);
		}

		.pastry-hero__copy {
			padding-inline: var(--space-2xl);
		}

		.pastry-bento__grid {
			grid-template-areas:
				"selection feature testimonial"
				"selection feature order";
			grid-template-columns: 3fr 6fr 3fr;
			grid-template-rows: repeat(2, minmax(0, 1fr));
			gap: var(--space-sm);
			min-height: clamp(30rem, 40vw, 42rem);
			align-items: stretch;
		}

		.pastry-bento__selection {
			flex-direction: column;
		}

		.pastry-bento__selection-media {
			flex: 1 1 auto;
			min-height: 0;
			aspect-ratio: auto;
		}

		.pastry-process {
			grid-template-columns: 1.15fr 1.35fr 0.55fr;
			align-items: stretch;
		}

		.pastry-process__copy {
			grid-row: auto;
		}

		.pastry-process__main-image {
			min-height: clamp(22rem, 30vw, 28rem);
		}

		.pastry-process__detail-images {
			grid-template-columns: 1fr;
		grid-template-rows: repeat(2, minmax(0, 1fr));
			height: 100%;
			min-height: 0;
		}

		.pastry-process__detail {
			aspect-ratio: auto;
			height: 100%;
			min-height: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pastry-hero__media :global(img),
		.pastry-bento__control,
		.pastry-bento__order,
		.pastry-bento__order-link span {
			transform: none;
			transition: none;
		}

		.pastry-bento__order:hover,
		.pastry-bento__order:focus-visible {
			transform: none;
		}
	}
</style>
