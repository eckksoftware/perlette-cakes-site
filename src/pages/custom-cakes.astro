---
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import CategoryCta from '@components/shared/CategoryCta.astro';
import { categoryBySlug, type Variation } from '@data/catalogue';
import { categoryJsonLd, type ListItemInput, SITE_ORIGIN } from '@lib/schema';

const cakeCategory = categoryBySlug('custom-cakes');
const url = 'https://perlettecakes.com/custom-cakes/';

const variationBySlug = (slug: string): Variation => {
	const variation = cakeCategory.variations.find((item) => item.slug === slug);
	if (!variation) throw new Error(`Unknown custom cake variation: ${slug}`);
	return variation;
};

const creamCakeHeader = variationBySlug('cream-cake');
const berriesCakeHeader = variationBySlug('berries-cake');

const cakeCards = [
	{
		variation: variationBySlug('layered-berries-cake'),
		name: 'Layered Berries Cake',
		size: 'Multi-layered cake',
		description: 'A bright, celebratory cake with soft sponge, fresh cream, and a finish made for the birthday table.', // improve description as needed
		badge: 'Popular',
		collections: ['featured', 'favorites'],
	},
	{
		variation: variationBySlug('crunchy-cake'),
		name: 'Homemade Chocolate Cake',
		size: '6-inch cake',
		description: 'A delicate floral finish for birthdays, thank-yous, and the occasions that deserve something thoughtful.', // improve description as needed
		badge: 'Favorite',
		collections: ['featured', 'favorites', 'newest'],
	},
	{
		variation: variationBySlug('tiramisu-cake'),
		name: '6" Chocolate Fudge Cake',
		size: '6-inch cake',
		description: 'Deep chocolate sponge with a rich fudge finish for celebrations that call for a more indulgent slice.',
		badge: 'Favorite',
		collections: ['featured', 'favorites'],
	},
	{
		variation: variationBySlug('berry-choc-cake'),
		name: '6" Vintage Heart Cake',
		size: '6-inch cake',
		description: 'A nostalgic piped design with room for a personal message, made for gifting and romantic milestones.',
		badge: 'New',
		collections: ['newest', 'favorites'],
	},
	{
		variation: variationBySlug('flowery-symmetrical-cake'),
		name: '4" Bento Cake',
		size: '4-inch cake',
		description: 'A little cake for a small surprise, with a custom message and a finish shaped around your moment.',
		badge: 'New',
		collections: ['newest'],
	},
	{
		variation: variationBySlug('molten-cake'),
		name: 'Custom Message Cake',
		size: 'Size discussed on WhatsApp',
		description: 'Bring us your colours, words, and references, and we will confirm what can be made for your date.',
		badge: 'Perlette favourite',
		collections: ['favorites'],
	},
];

const faqs = [
	{
		question: 'How far ahead should I order a custom cake?',
		answer:
			'Custom cakes are best ordered 3 to 5 days ahead. Larger or more detailed designs may need more notice, so share your date and idea with us on WhatsApp early.',
	},
	{
		question: 'Can I request a specific design or flavour?',
		answer:
			'Yes. Customisation is subject to availability and the design requirements. Send your references, preferred flavour, size, and delivery date on WhatsApp so we can confirm the details.',
	},
	{
		question: 'Which cake sizes are available?',
		answer:
			'Sizes depend on the cake style and number of guests. The examples on this page show common reference sizes; we can recommend a size when you share how many people you are serving.',
	},
	{
		question: 'Do you deliver custom cakes?',
		answer:
			'Perlette Cakes delivers across Klang Valley through Lalamove. There is no physical storefront and no customer pickup.',
	},
	{
		question: 'Are eggless or vegan cakes available?',
		answer:
			'Eggless and vegan cakes are available for selected flavours on request. Please discuss dietary needs directly with us on WhatsApp.',
	},
];

const schemaItems: ListItemInput[] = [
	...cakeCards.map((cake) => ({
		name: cake.name,
		description: cake.description,
		image: `${SITE_ORIGIN}${cake.variation.image.src}`,
	})),
];
const jsonLd = categoryJsonLd(cakeCategory, url, schemaItems);
---

<Layout
	title={cakeCategory.title}
	description={cakeCategory.description}
	canonicalUrl={url}
	noIndex={false}
	jsonLd={jsonLd}
>
	<main class="custom-cakes-page">
		<section class="custom-hero content-shell">
			<div class="custom-hero__images" data-reveal>
				<div class="custom-hero__image">
					<Image
						src={creamCakeHeader.image}
						alt={creamCakeHeader.imageAlt}
						loading="eager"
						fetchpriority="high"
						widths={[480, 720, 960]}
						sizes="(min-width: 64rem) 22vw, 48vw"
						quality={72}
					/>
				</div>
				<div class="custom-hero__image">
					<Image
						src={berriesCakeHeader.image}
						alt={berriesCakeHeader.imageAlt}
						loading="lazy"
						widths={[480, 720, 960]}
						sizes="(min-width: 64rem) 22vw, 48vw"
						quality={72}
					/>
				</div>
			</div>

			<div class="custom-hero__copy" data-reveal>
				<p class="text-header">CUSTOM CAKES IN KLANG VALLEY</p>
				<h1>Finest Perlette Cakes</h1>
				<p class="custom-hero__lead">
					Each cake is baked for one date, one table and one moment that lasts a lifetime. Scroll through our cakes and take a peak at what we can offer.
				</p>
				<p>
					Want something different? Shoot us a message.
				</p>
				<CategoryCta
					variant="inline"
					label="Start your cake on WhatsApp"
					whatsappMessage={cakeCategory.whatsappMessage}
					interest={cakeCategory.modalInterest}
				/>
			</div>
		</section>

		<section class="cake-collection content-shell" aria-labelledby="cake-collection-title">
			<div class="section-heading section-space" data-reveal>
				<div>
					<p class="text-header">OUR FAMOUS CAKES</p>
					<h2 id="cake-collection-title">Cakes in demand</h2>
				</div>
				<label class="cake-filter">
					<select data-cake-filter>
						<option value="featured">Featured</option>
						<option value="newest">Newest</option>
						<option value="favorites">Favourites</option>
					</select>
				</label>
			</div>

			<div class="cake-grid">
				{cakeCards.map((cake) => (
					<article class="cake-card" data-cake-card data-collections={cake.collections.join(' ')} data-reveal>
						<div class="cake-card__media">
							<span class="cake-card__badge">{cake.badge}</span>
							<Image
								src={cake.variation.image}
								alt={cake.variation.imageAlt}
								loading="lazy"
								widths={[360, 540, 720]}
								sizes="(min-width: 64rem) 28vw, (min-width: 48rem) 45vw, 92vw"
								quality={66}
							/>
						</div>
						<div class="cake-card__copy">
							<p class="cake-card__size">{cake.size}</p>
							<h3>{cake.name}</h3>
							<p>{cake.description}</p>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="how-it-works content-shell section-space" aria-labelledby="how-it-works-title">
			<div class="how-it-works__image" data-reveal>
				<Image
					src={variationBySlug('lemon-mini-cake').image}
					alt={variationBySlug('lemon-mini-cake').imageAlt}
					loading="lazy"
					widths={[600, 900, 1200]}
					sizes="(min-width: 64rem) 48vw, 92vw"
					quality={70}
				/>
			</div>
			<div class="how-it-works__copy" data-reveal>
				<p class="text-header">GET YOUR CAKE EASILY</p>
				<h2 id="how-it-works-title">Cakes delivered to your doorsteps</h2>
				<ol class="steps">
					<li>
						<strong>Choose your cake</strong>
						<span>Explore our cake collection or reach out to us for a custom order.</span>
					</li>
					<li>
						<strong>Schedule your delivery</strong>
						<span>Share your date and delivery area. We will confirm the order and arrange Lalamove across Klang Valley.</span>
					</li>
					<li>
						<strong>Await the good part</strong>
						<span>We bake your cake fresh for the occasion, then send it to your door. There is no pickup.</span>
					</li>
				</ol>
			</div>
		</section>

		<section class="cake-faq content-shell section-space" aria-labelledby="cake-faq-title">
			<div class="cake-faq__copy" data-reveal>
				<p class="text-header">COMMON CAKE QUESTIONS</p>
				<h2 id="cake-faq-title">Before choosing a cake</h2>
				<p class="cake-faq__intro">The practical details, kept simple.</p>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details class="faq-item" data-faq-item>
							<summary>{faq.question}<span aria-hidden="true">+</span></summary>
							<div class="faq-item__answer" aria-hidden="true">
								<div><p>{faq.answer}</p></div>
							</div>
						</details>
					))}
				</div>
			</div>
			<div class="cake-faq__image" data-reveal>
				<Image
					src={variationBySlug('orange-cake').image}
					alt={variationBySlug('orange-cake').imageAlt}
					loading="lazy"
					widths={[600, 900, 1200]}
					sizes="(min-width: 64rem) 42vw, 92vw"
					quality={70}
				/>
			</div>
		</section>

		<section class="occasions content-shell section-space" aria-labelledby="occasions-title">
			<div class="occasions__heading" data-reveal>
				<p class="text-header">MADE TO ELEVATE THE MOMENTS</p>
				<h2 id="occasions-title">As personal as the moment itself</h2>
				<p>Custom cakes for the birthdays, anniversaries, and little life milestones that deserve more than an ordinary dessert.</p>
			</div>
			<div class="occasion-grid">
				<article class="occasion-card" data-reveal>
					<Image src={variationBySlug('flowery-symmetrical-cake').image} alt={variationBySlug('flowery-symmetrical-cake').imageAlt} loading="lazy" widths={[480, 720, 960]} sizes="(min-width: 64rem) 30vw, 92vw" quality={68} />
					<div>
						<h3>Birthdays</h3>
						<p>A cake with their favourite colours, flavours, and a message made just for them.</p>
					</div>
				</article>
				<article class="occasion-card" data-reveal>
					<Image src={variationBySlug('christmas-cake').image} alt={variationBySlug('christmas-cake').imageAlt} loading="lazy" widths={[480, 720, 960]} sizes="(min-width: 64rem) 30vw, 92vw" quality={68} />
					<div>
						<h3>Festive</h3>
						<p>Cakes fits in all occasions and festivities - we cater to any festive seasons</p>
					</div>
				</article>
				<article class="occasion-card" data-reveal>
					<Image src={variationBySlug('gifts-cake').image} alt={variationBySlug('gifts-cake').imageAlt}  loading="lazy" widths={[480, 720, 960]} sizes="(min-width: 64rem) 30vw, 92vw" quality={68} />
					<div>
						<h3>New beginnings</h3>
						<p>For gender reveals, new homes, promotions, and every occasion worth gathering for.</p>
					</div>
				</article>
			</div>
		</section>

		<CategoryCta
			variant="panel"
			heading="Got the date? Let's make the cake."
			body="Tell us what you are celebrating, and we will take it from there on WhatsApp."
			label="Start your cake order"
			whatsappMessage={cakeCategory.whatsappMessage}
			interest={cakeCategory.modalInterest}
		/>
	</main>
</Layout>

<script>
	const filter = document.querySelector<HTMLSelectElement>('[data-cake-filter]');
	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-cake-card]'));

	const applyFilter = (collection: string) => {
		cards.forEach((card) => {
			const collections = card.dataset.collections?.split(' ') ?? [];
			card.hidden = collection !== 'all' && !collections.includes(collection);
		});
	};

	filter?.addEventListener('change', () => applyFilter(filter.value));
	if (filter) applyFilter(filter.value);

	document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]').forEach((item) => {
		const summary = item.querySelector<HTMLElement>('summary');
		const answer = item.querySelector<HTMLElement>('.faq-item__answer');
		if (!summary || !answer) return;

		summary.addEventListener('click', (event) => {
			event.preventDefault();
			const shouldOpen = !item.classList.contains('is-open');

			if (shouldOpen) {
				item.setAttribute('open', '');
				answer.setAttribute('aria-hidden', 'false');
				requestAnimationFrame(() => item.classList.add('is-open'));
				return;
			}

			item.classList.remove('is-open');
			answer.setAttribute('aria-hidden', 'true');
			window.setTimeout(() => {
				if (!item.classList.contains('is-open')) item.removeAttribute('open');
			}, 280);
		});
	});
</script>

<style>
	.custom-hero {
		display: grid;
		gap: var(--space-xl);
		align-items: center;
		padding-top: var(--space-2xl);
		padding-bottom: var(--space-2xl);
	}

	.custom-hero__images {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-xs);
	}

	.custom-hero__image {
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-surface-soft);
	}

	.custom-hero__image :global(img),
	.how-it-works__image :global(img),
	.cake-faq__image :global(img),
	.occasion-card :global(img),
	.cake-card__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.custom-hero__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-md);
		max-width: 38rem;
	}

	.custom-hero__lead {
		font-size: var(--step-1);
		line-height: 1.4;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-xl);
		padding-bottom: var(--space-xl);
	}

	.cake-collection {
		padding-top: var(--top-space-section-md);
		padding-bottom: var(--bottom-space-section-md);
		background: var(--color-primary);
		color: var(--color-primary-strong);
	}

	.cake-collection .text-header,
	.cake-collection .cake-filter {
		color: var(--color-on-primary);
	}

	.cake-collection h2 {
		color: var(--color-on-primary);
	}

	.section-heading > div {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.cake-filter {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		min-width: 12rem;
		color: var(--color-text);
		font-size: var(--label-text-font-size);
		font-weight: 700;
		text-transform: uppercase;
	}

	.cake-filter select {
		min-height: 3rem;
		padding: 0.6rem 2.6rem 0.9rem var(--space-md);
		border: 1px solid var(--color-primary-strong);
		border-radius: 999px;
		font-weight: 700;
	}

	.cake-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: var(--space-lg);
	}

	.cake-card {
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-surface);
		color: var(--color-text);
		box-shadow: var(--shadow-sm);
	}

	.cake-card[hidden] {
		display: none;
	}

	.cake-card__media {
		position: relative;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		background: var(--color-surface-soft);
	}

	.cake-card__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 700ms cubic-bezier(0.2, 0.6, 0.2, 1);
	}

	.cake-card:hover .cake-card__media :global(img) {
		transform: scale(1.04);
	}

	.cake-card__badge {
		position: absolute;
		top: var(--space-md);
		right: var(--space-md);
		z-index: 1;
		padding: var(--space-sm) var(--space-md);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-primary-strong);
		font-size: var(--label-text-font-size);
		font-weight: 700;
	}

	.cake-card__copy {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		padding: var(--space-lg);
		text-align: center;
	}

	.cake-card__copy h3 {
		font-size: var(--step-1);
		line-height: 1.05;
		text-transform: uppercase;
	}

	.cake-card__copy p {
		font-size: var(--label-text-font-size);
	}

	.cake-card__size {
		color: var(--color-primary-strong);
		font-size: var(--step--1) !important;
		font-weight: 700;
		text-transform: uppercase;
	}

	.how-it-works,
	.cake-faq {
		display: grid;
		gap: var(--space-2xl);
		align-items: center;
	}

	.how-it-works__image,
	.cake-faq__image {
		aspect-ratio: 1 / 1;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-surface-soft);
	}

	.how-it-works__copy,
	.cake-faq__copy {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.steps,
	.faq-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.steps {
		display: grid;
		gap: var(--space-lg);
	}

	.steps li {
		display: grid;
		gap: var(--space-xs);
		padding-left: var(--space-lg);
		border-left: 2px solid var(--color-primary);
	}

	.steps strong {
		font-family: var(--font-display);
		font-size: var(--step-1);
	}

	.steps span {
		font-size: var(--label-text-font-size);
	}

	.cake-faq {
		background: var(--color-surface-soft);
	}

	.cake-faq__intro {
		color: var(--color-text-muted);
	}

	.faq-item {
		border-top: 1px solid var(--color-nav-border);
	}

	.faq-item:last-child {
		border-bottom: 1px solid var(--color-nav-border);
	}

	.faq-item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		padding-block: var(--space-md);
		cursor: pointer;
		font-weight: 700;
		list-style: none;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary span {
		display: inline-block;
		color: var(--color-primary-strong);
		font-size: var(--step-1);
		font-weight: 400;
	}

	.faq-item[open] summary span {
		transform: rotate(45deg);
	}

	.faq-item__answer {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		transition: grid-template-rows 280ms ease, opacity 280ms ease;
	}

	.faq-item.is-open .faq-item__answer {
		grid-template-rows: 1fr;
		opacity: 1;
	}

	.faq-item__answer > div {
		overflow: hidden;
	}

	.faq-item__answer p {
		padding: 0 var(--space-xl) var(--space-lg) 0;
		color: var(--color-text-muted);
		font-size: var(--label-text-font-size);
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item__answer {
			transition: none;
		}
	}

	.occasions {
		padding-bottom: var(--space-2xl);
		background: var(--color-primary);
		color: var(--color-on-primary);
	}

	.occasions .text-header {
		color: var(--color-on-primary);
	}

	.occasions__heading {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		max-width: 60rem;
		margin-bottom: var(--space-xl);
		text-align: center;
		margin-inline: auto;
	}

	.occasion-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: var(--space-lg);
	}

	.occasion-card {
		display: flex;
		flex-direction: column;
		text-align: center;
	}

	.occasion-card :global(img) {
		aspect-ratio: 4 / 3;
		border-top-left-radius: var(--radius-md);
		border-top-right-radius: var(--radius-md);
	}

	.occasion-card h3 {
		font-size: var(--step-2);
	}

	.occasion-card div {
		padding: var(--space-sm) 0 var(--space-sm) 0;
		background-color: var(--color-page);
		color: var(--color-text);
	}

	@media (max-width: 25rem) {

		.section-heading {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-xl);
			padding-bottom: var(--space-xl);
		}

		.cake-filter {
			width: 100%;
		}
	}

	@media (min-width: 48rem) {
		.custom-hero {
			grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
			gap: var(--space-2xl);
		}

		.cake-grid,
		.occasion-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.how-it-works,
		.cake-faq {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.cake-grid,
		.occasion-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.cake-faq__image {
			order: 2;
		}
	}
</style>
