---
import { SEO } from 'astro-seo';
import OrderInquiryModal from '../components/OrderInquiryModal.astro';
import '../assets/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  noIndex: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  socialImageUrl?: string;
  socialImageAlt?: string;
}

const {
  title,
  description,
  canonicalUrl,
  noIndex,
  jsonLd = [],
  socialImageUrl = 'https://perlettecakes.com/perlette-logo.svg',
  socialImageAlt = 'Perlette Cakes logo on a blush background.',
} = Astro.props;

const businessJsonLd = {
  "@context": "https://schema.org",
  "@type": "Bakery",
  "@id": "https://perlettecakes.com/#business",
  name: "Perlette Cakes",
  url: "https://perlettecakes.com/",
  telephone: "+60196505050",
  description:
    "Home-based baker making custom celebration cakes, cupcakes, cookies, and pastries for delivery across Klang Valley, Malaysia. Order via WhatsApp.",
  areaServed: "Klang Valley, Malaysia",
  sameAs: [
    "https://www.instagram.com/perlettecakes",
  ],
  potentialAction: {
    "@type": "OrderAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: "https://wa.me/60196505050",
      actionPlatform: "https://schema.org/DesktopWebPlatform",
      inLanguage: "en",
    },
    deliveryMethod: {
      "@type": "DeliveryMethod",
      name: "Third-party delivery (Lalamove)",
    },
  },
};
 
// Merge business schema with any page-specific schemas
const allJsonLd = [
  businessJsonLd,
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];

---

<!doctype html>
<html lang="en">
	<head>
		<SEO
			title={title}
			description={description}
			charset="UTF-8"
			canonical={canonicalUrl}
			noindex={noIndex}
			nofollow={noIndex}
			robotsExtras="max-image-preview:large, max-snippet:-1, max-video-preview:-1"
			openGraph={{
				basic: {
					title,
					type: 'website',
					image: socialImageUrl,
					url: canonicalUrl,
				},
				optional: {
					description,
					locale: 'en_MY',
					siteName: 'Perlette Cakes',
				},
				image: {
					alt: socialImageAlt,
				},
			}}
			twitter={{
				card: 'summary',
				title,
				description,
				image: socialImageUrl,
				imageAlt: socialImageAlt,
			}}
			extend={{
				link: [
					{ rel: 'icon', type: 'image/svg+xml', href: '/perlette-logo.svg' },
				],
			}}
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="language" content="English" />

		{allJsonLd.map((schema) => (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}

	</head>
	<body>
		<div class="site-shell">
			<slot />
			<OrderInquiryModal />
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}

	.site-shell {
		min-height: 100vh;
	}

</style>
