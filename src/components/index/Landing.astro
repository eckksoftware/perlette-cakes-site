---
import Faq from './Faq.astro';
import FeaturedCategories from './FeaturedCategories.astro';
import Hero from './Hero.astro';
import HowOrderingWorks from './HowOrderingWorks.astro';
import OwnerStory from './OwnerStory.astro';
import WhatsAppCta from './WhatsAppCta.astro';
import { DEFAULT_INQUIRY, whatsappHref } from '../../lib/whatsapp';

const instagramHref = 'https://www.instagram.com/perlettecakes';
const orderHref = whatsappHref(DEFAULT_INQUIRY);
---

<main>
	<Hero whatsappHref={orderHref} instagramHref={instagramHref} />
	<FeaturedCategories />
	<OwnerStory />
	<HowOrderingWorks whatsappHref={orderHref} />
	<WhatsAppCta whatsappHref={orderHref} />
	<Faq whatsappHref={orderHref} />
</main>
